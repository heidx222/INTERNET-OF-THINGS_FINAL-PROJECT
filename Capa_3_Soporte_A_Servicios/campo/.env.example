# =================================================================
# PROYECTO: Sistema IoT Autónomo - Cuenca Chancay-Huaral (Yaku Qhawaq)
# ARCHIVO:  .env.example  (Capa 3 - Soporte a Servicios / backend FastAPI)
# -----------------------------------------------------------------
# ⚠️  ESTE ES UNO DE LOS ARCHIVOS DONDE TÚ COLOCAS TUS CREDENCIALES.
#
# En LOCAL: copia este archivo a `.env`.
# En RAILWAY: NO subas el .env; crea estas variables en la pestaña
#             "Variables" del servicio (Railway las inyecta al contenedor).
#
# Regla de oro: NUNCA subas el archivo `.env` real al repositorio.
# =================================================================

# ---------------------------------------------------------------
# BASE DE DATOS PostgreSQL
# ---------------------------------------------------------------
# Opción A (RECOMENDADA en Railway): añade el plugin "PostgreSQL" al
# proyecto y referencia su variable ${{Postgres.DATABASE_URL}}.
# El código acepta el esquema "postgres://" y lo normaliza a "postgresql://".
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Opción B (manual / local): si NO defines DATABASE_URL, se usan estas:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chancayhuaral_auth
DB_USER=adminChancayHuaral
DB_PASS=adminChancayHuaral123

# ---------------------------------------------------------------
# BROKER MQTT (Capa 2)
# ---------------------------------------------------------------
# Host y puerto del broker Mosquitto. En producción suele ser el proxy
# TCP público de Railway del servicio broker, p. ej.:
#   MQTT_HOST=<tu-proxy>.proxy.rlwy.net
#   MQTT_PORT=<puerto-publico-TCP>
# Si el backend y el broker están en el MISMO proyecto de Railway, usa
# la URL de red privada del broker (Settings -> Networking).
MQTT_HOST=iriguchi.proxy.rlwy.net
MQTT_PORT=28182
MQTT_USER=backend_central
MQTT_PASSWORD=backendChancay2026

# Tópico raíz de telemetría que el backend escucha (comodín de cuenca).
MQTT_TOPIC=chancay/cuenca/#

# ---------------------------------------------------------------
# OPCIONAL
# ---------------------------------------------------------------
# Umbral de contaminación del Isolation Forest si reentrenas en runtime.
# IF_CONTAMINATION=0.01
