# =================================================================
# ARCHIVO: .env.example  (Capa 2 - Simulador histórico)
# -----------------------------------------------------------------
# ⚠️  ARCHIVO DONDE COLOCAS TUS DATOS.
# En Railway: crea estas variables en la pestaña "Variables" del
# servicio simulador (NO subas el .env real al repositorio).
# =================================================================

# --- Broker MQTT (destino de la inyección) ---
# Si el broker está en el MISMO proyecto Railway usa su hostname privado
# (p.ej. broker.railway.internal) y el puerto interno 1883. Si está
# fuera, usa el host/puerto del TCP Proxy público.
MQTT_HOST=iriguchi.proxy.rlwy.net
MQTT_PORT=28182

# Credenciales del simulador (deben existir en test_user/test_acl)
MQTT_USER=simulador_python
MQTT_PASS=simulador123

# Tópico histórico de la cuenca (no cambiar)
MQTT_TOPIC=chancay/cuenca/historico

# Archivo del dataset (por defecto el incluido en la imagen)
CSV_FILE=dataset_sintetico_chancay.csv
