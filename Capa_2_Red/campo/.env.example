# =================================================================
# PROYECTO: Sistema IoT Autónomo - Cuenca Chancay-Huaral (Yaku Qhawaq)
# ARCHIVO:  .env.example  (Capa 2 - Red)
# Copiar a `.env` y ajustar los valores. NUNCA subir `.env` al repo.
# =================================================================

# --- Broker MQTT (Capa 2) ---
# Local (docker-compose campo) o proxy TCP de Railway para pruebas en la nube.
MQTT_HOST=localhost
MQTT_PORT=1883
# Credenciales del simulador histórico (definidas en postgres/init.sql)
MQTT_USER=simulador_python
MQTT_PASS=simulador123

# --- Tópicos y dataset ---
MQTT_TOPIC=chancay/cuenca/historico
CSV_FILE=dataset_sintetico_chancay.csv

# --- Base de datos PostgreSQL (Mosquitto Go Auth + Capa 3) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chancayhuaral_auth
DB_USER=adminChancayHuaral
DB_PASS=adminChancayHuaral123
