FROM nodered/node-red:latest-minimal

USER root

# Instalar dependencias del sistema si fueran necesarias
RUN apk add --no-cache bash

USER node-red

# Instalar únicamente nodos de comunicación y procesamiento
RUN npm install node-red-node-rbe

# [MODIFICADO PARA RAILWAY] En docker-compose local, la carpeta
# nodered-data se monta como volumen (-v ./nodered-data:/data), por lo
# que los flujos, credenciales y settings se cargan sin necesidad de
# copiarlos. En Railway no hay volúmenes montados desde el repo, así
# que "horneamos" esa misma configuración directo dentro de la imagen.
COPY --chown=node-red:node-red nodered-data/ /data/

# Exponer el puerto por defecto de Node-RED (para la API y edición)
EXPOSE 1880
